# TMDB API key for movie metadata enrichment
# Get a free key from https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Cloudflare Pages deployment settings
# Get these from https://dash.cloudflare.com/
#
# Account ID: Found in the right sidebar of your account dashboard
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# API Token: Create at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account > Cloudflare Pages > Edit
CLOUDFLARE_API_TOKEN=your_api_token_here

# Project name: The name of your Cloudflare Pages project
# Create one first at https://dash.cloudflare.com/ > Pages > Create a project > Direct Upload
CLOUDFLARE_PROJECT_NAME=film-finder

# Optional: Static site output directory (default: html)
# STATIC_OUTPUT_DIR=html

# Background service settings
# Update interval in hours (default: 12)
# UPDATE_INTERVAL_HOURS=12

# PID file location for the daemon (default: film-finder.pid)
# PID_FILE=film-finder.pid

# Log file location for the daemon (default: film-finder.log)
# LOG_FILE=film-finder.log

# Debug logging for scrapers (set to "true" to enable verbose logging)
# Useful for diagnosing issues with scraper selectors and parsing
# DEBUG_SCRAPERS=true
